FLUX_ENV=local
FLUX_SERVICE_NAME=flux-control-plane
FLUX_LOG_LEVEL=INFO
FLUX_LOG_JSON=true
FLUX_DATABASE_URL=postgresql+asyncpg://flux:flux@localhost:5432/flux
FLUX_DB_ECHO=false
FLUX_DB_POOL_SIZE=10
FLUX_DB_MAX_OVERFLOW=20
FLUX_DB_POOL_RECYCLE=1800
FLUX_API_KEY_PEPPER=change-me-in-production
FLUX_OTEL_ENABLED=false
FLUX_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Serving backend and worker discovery (Phase 4) ---
# stub (default): in-process engine. remote: route to registered workers.
FLUX_SERVING_BACKEND=stub
# A worker is a routing candidate only while its heartbeat is this fresh.
FLUX_WORKER_HEARTBEAT_TTL_SECONDS=60
# Per-request timeout when the gateway calls a worker (remote mode).
FLUX_REMOTE_REQUEST_TIMEOUT_SECONDS=30.0

# --- Usage metering and pricing (Phase 5 Part A) ---
# When true, non-streaming completions are metered into usage_records.
FLUX_METERING_ENABLED=true
# Default per-1000-token rates used for models without an explicit price.
FLUX_DEFAULT_PROMPT_PER_1K=0.0005
FLUX_DEFAULT_COMPLETION_PER_1K=0.0015
# Currency label reported alongside cost figures.
FLUX_BILLING_CURRENCY=USD

# --- Budgets and enforcement (Phase 5 Part B) ---
# When true, a tenant that has spent past its monthly budget is blocked at the
# serving path with HTTP 402. Budgets themselves are managed via /v1/budgets
# regardless of this flag; only enforcement is gated here.
FLUX_BUDGET_ENFORCEMENT_ENABLED=false
