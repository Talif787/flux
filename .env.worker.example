# Flux worker configuration (prefix FLUX_WORKER_). Copy to .env.worker.
# The worker self-registers with the control plane and serves inference.

# Identity and models
FLUX_WORKER_NAME=worker-1
# Comma-separated model names this worker serves (must match registered model names).
FLUX_WORKER_SERVED_MODELS=gpt-stub
FLUX_WORKER_MAX_CONCURRENCY=8

# Self-registration with the control plane (all three required to self-register)
FLUX_WORKER_CONTROL_PLANE_URL=http://localhost:8000
FLUX_WORKER_ADVERTISE_URL=http://localhost:8090
FLUX_WORKER_API_KEY=            # a key with the worker.register role
FLUX_WORKER_HEARTBEAT_INTERVAL_SECONDS=5

# Inference backend: "echo" (default, echoes the prompt) or "openai"
# (proxies to any OpenAI-compatible server: vLLM, Ollama, TGI, or OpenAI).
FLUX_WORKER_BACKEND=echo

# --- openai backend settings (only when FLUX_WORKER_BACKEND=openai) ---
# base_url must include /v1. Examples:
#   Ollama:  http://localhost:11434/v1
#   OpenAI:  https://api.openai.com/v1
FLUX_WORKER_UPSTREAM_BASE_URL=
# API key for the upstream (blank for Ollama; sk-... for OpenAI). Server-side only.
FLUX_WORKER_UPSTREAM_API_KEY=
# Optional: override the model name sent upstream (leave blank to pass through the
# requested model name unchanged).
FLUX_WORKER_UPSTREAM_MODEL=
# Upstream request timeout in seconds (raise for slow CPU inference).
FLUX_WORKER_REQUEST_TIMEOUT_SECONDS=60
